# Local services
DEMO_API_URL=http://localhost:8787
PORT=8787

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=ReplaceWithDeployedProgramId
SOLANA_GAME_MANAGER_ID=ReplaceWithInitializedGameManagerPda
SOLANA_FREEZE_AUTHORITY_PDA=ReplaceWithProgramFreezeAuthorityPda
SOLANA_DEMO_NFT_MINTS=mint1,mint2,mint3

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_CLAN_GAME_ADDRESS=0x0000000000000000000000000000000000000000
BASE_RELAYER_PRIVATE_KEY=0xreplace_only_for_mock_signing_or_contract_deploys
LIVE_BASE_RELAY=false

# Signing adapter: mock or ika
SIGNING_ADAPTER=mock
MOCK_DWALLET_PRIVATE_KEYS=0xreplace_player_1,0xreplace_player_2

# Ika pre-alpha
IKA_ENABLED=false
IKA_PRE_ALPHA_ENDPOINT=
IKA_PROGRAM_ID=
IKA_DWALLET_IDS=dwallet-1,dwallet-2
IKA_DWALLET_BASE_ADDRESSES=0xplayer1,0xplayer2

# AWS deploy helpers
AWS_REGION=us-east-1
ECR_RELAYER_IMAGE=
