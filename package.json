{
  "name": "clanworld-ika-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @clanworld/demo-web dev",
    "dev:relayer": "pnpm --filter @clanworld/relayer dev",
    "dev": "pnpm dev:relayer & pnpm dev:web",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' --filter './contracts/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx --test tests/*.test.ts",
    "review": "node scripts/review-project.mjs",
    "zip": "node scripts/zip-project.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@clanworld/solana-sdk": "workspace:*",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.7"
  }
}
